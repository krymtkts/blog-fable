<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnableExpectoTestingPlatformIntegration>true</EnableExpectoTestingPlatformIntegration>

    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DevServer.fs" />
    <Compile Include="TestHelpers.fs" />
    <Compile Include="ServerTests.fs" />
    <Compile Include="SnapshotTests.fs" />
    <Compile Include="LlmTests.fs" />
    <Compile Include="BooklogTests.fs" />
    <Compile Include="SearchTests.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Fake.Core.Process" />
    <PackageReference Include="Fake.DotNet.Cli" />
    <PackageReference Include="Fake.JavaScript.Npm" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Suave" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>
</Project>
