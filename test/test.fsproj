<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnableExpectoTestingPlatformIntegration>true</EnableExpectoTestingPlatformIntegration>

    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DevServer.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="Fake.DotNet.Cli" Version="6.1.4" />
    <PackageReference Include="Fake.JavaScript.Npm" Version="6.1.4" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- NOTE: Suave 3.4.4 pin FSharp.Core 10.1.102. so we use Suave 3.4.3 to use higher FSharp.Core 10.1.400 -->
    <PackageReference Include="Suave" Version="3.4.5" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
    <!-- NOTE: Add explicit dependency overrides to address vulnerabilities related to Fake.DotNet.Cli. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
  </ItemGroup>
</Project>
